##6. Exception Handling
#Write a program that accepts a number from the user and handles invalid input using try-except.
#Example:
#python Enter a number: abc Invalid Input
try:

    number = int(input("Enter a number: "))

    print("Given number:", number)

except:

    print("Invalid Input")

##7. Division Calculator
#Accept two numbers from the user and perform division.
#Handle:
#- Invalid input
#- Division by zero
try:

    num1 = int(input("Enter first number: "))
    num2 = int(input("Enter second number: "))

    result = num1 / num2

    print("Result:", result)

except ZeroDivisionError:

    print("we can't divide by zero")

except:

    print("Invalid Input")

